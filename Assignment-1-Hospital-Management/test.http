### GET all doctors filtered by specialization
GET http://localhost:4004/odata/v4/hospital/Doctors?$filter=specialization eq 'Cardiology'


### GET appointments for a specific date
GET http://localhost:4004/odata/v4/hospital/Appointments?$filter=appointmentDate eq 2026-06-01


### POST a new patient
POST http://localhost:4004/odata/v4/hospital/Patients
Content-Type: application/json

{
  "firstName": "Meera",
  "lastName": "Mohanty",
  "dateOfBirth": "1999-04-12",
  "gender": "Female",
  "bloodGroup": "BPositive",
  "phone": "9222222222",
  "email": "meera@gmail.com",
  "address": "Bhubaneswar",
  "emergencyContact": "9333333333",
  "registrationDate": "2026-06-10"
}


### POST a new appointment
POST http://localhost:4004/odata/v4/hospital/Appointments
Content-Type: application/json

{
  "patientId": "00000000-0000-0000-0000-000000000201",
  "doctorId": "00000000-0000-0000-0000-000000000101",
  "appointmentDate": "2026-06-10",
  "appointmentTime": "10:30:00",
  "reason": "Chest pain",
  "notes": "New consultation",
  "fee": 800
}


### GET patients filtered by blood group
GET http://localhost:4004/odata/v4/hospital/Patients?$filter=bloodGroup eq 'APositive'


### PATCH appointment status to Completed
PATCH http://localhost:4004/odata/v4/hospital/Appointments(ID=00000000-0000-0000-0000-000000000301)
Content-Type: application/json

{
  "status": "Completed"
}

### GET only Cardiology doctors
GET http://localhost:4004/odata/v4/hospital/Doctors?$filter=specialization eq 'Cardiology'

### Sort patients by registration date
GET http://localhost:4004/odata/v4/hospital/Patients?$orderby=registrationDate desc

### Select only specific fields for doctors
GET http://localhost:4004/odata/v4/hospital/Doctors?$select=firstName,lastName,specialization

### GET first 2 appointments
GET http://localhost:4004/odata/v4/hospital/Appointments?$top=2 

### GET count of doctors
GET http://localhost:4004/odata/v4/hospital/Doctors/$count