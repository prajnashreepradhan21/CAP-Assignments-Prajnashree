{
  "xsappname": "po-management",
  "tenant-mode": "dedicated",
  "scopes": [
    { "name": "$XSAPPNAME.Read", "description": "Read PO data" },
    { "name": "$XSAPPNAME.Create", "description": "Create and edit Purchase Orders" },
    { "name": "$XSAPPNAME.Approve", "description": "Approve Purchase Orders" },
    { "name": "$XSAPPNAME.Delete", "description": "Delete Purchase Orders" },
    { "name": "$XSAPPNAME.Admin", "description": "Admin access" },
    { "name": "$XSAPPNAME.Viewer", "description": "Viewer role" },
    { "name": "$XSAPPNAME.PurchaseManager", "description": "Purchase Manager role" },
    { "name": "$XSAPPNAME.Administrator", "description": "Administrator role" }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Viewer",
      "scope-references": [
        "$XSAPPNAME.Read",
        "$XSAPPNAME.Viewer"
      ]
    },
    {
      "name": "PurchaseManager",
      "scope-references": [
        "$XSAPPNAME.Read",
        "$XSAPPNAME.Create",
        "$XSAPPNAME.Approve",
        "$XSAPPNAME.PurchaseManager"
      ]
    },
    {
      "name": "Administrator",
      "scope-references": [
        "$XSAPPNAME.Read",
        "$XSAPPNAME.Create",
        "$XSAPPNAME.Approve",
        "$XSAPPNAME.Delete",
        "$XSAPPNAME.Admin",
        "$XSAPPNAME.Administrator"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "PO_Viewer",
      "role-template-references": ["$XSAPPNAME.Viewer"]
    },
    {
      "name": "PO_Manager",
      "role-template-references": ["$XSAPPNAME.PurchaseManager"]
    },
    {
      "name": "PO_Admin",
      "role-template-references": ["$XSAPPNAME.Administrator"]
    }
  ]
}